# 1. Real Email Forwarding via Resend (Free 3,000 emails/month at https://resend.com)
# Get a free API key from https://resend.com/api-keys
# RESEND_API_KEY=re_your_api_key_here

# The recipient address where you want to receive direct messages (default: christophermathai123@gmail.com)
# CONTACT_NOTIFICATION_EMAIL=christophermathai123@gmail.com

# 2. Alternative: Instant Discord Channel Webhook
# Paste a Discord channel webhook URL to get instant notifications on Discord
# CONTACT_WEBHOOK_URL=https://discord.com/api/webhooks/...
