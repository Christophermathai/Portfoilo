{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:localhost)",

      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(echo:*)",

      "Bash(lsof -ti:*)",
      "Bash(xargs kill:*)",
      "Bash(pkill -f next:*)",
      "Bash(pkill -9 -f 'claude -p')",
      "Bash(jobs -l)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git fetch:*)",
      "Bash(git stash:*)",
      "Bash(git pull:*)",
      "Bash(git fsck:*)",
      "Bash(git ls-tree:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",

      "Bash(npm run:*)",
      "Bash(npx prettier:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(npx playwright:*)",

      "Bash(claude -p --help)",

      "Edit(/.claude/skills/brainstorm/**)",
      "Edit(/.claude/skills/capture-behavior/**)",
      "Edit(/.claude/skills/check-issue/**)",
      "Edit(/.claude/skills/claude-settings-cleanup/**)"
    ],
    "additionalDirectories": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lint.sh",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
